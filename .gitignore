# Environnement Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Modèles YOLO (trop lourds) — sauf les best.pt entraînés (baseline + versions)
*.pt
*.onnx
*.engine
!Application/ml/runs/baseline/train/weights/best.pt
!Application/models/best_*.pt

# Dataset images (5000+ images — trop lourd pour git)
# On garde classes.json, manifest.json et data.yaml (petits fichiers de config)
Application/dataset/raw/
Application/dataset/versions/
Application/dataset/current/

# Rapports : on garde les .md/.json, pas les images
Application/reports/predict/
Application/reports/**/*.jpg
Application/reports/**/*.png

# Anciens runs YOLO (le best.pt baseline déjà tracké reste tracké)
Application/ml/runs/

# Sorties TestYolo
TestYolo/runs/

# Logs
*.log
logs/

# Fichiers temporaires
_tmp_crop.png
*.tmp

# AB Method / Claude (interne)
.ab-method/
.claude/

# Tests locaux uniquement
test_app.py

# Docs internes
# docs internes AB Method (trackers, handoffs) hors git ; la doc projet (*.md racine de docs/) est versionnee
docs/tasks/
docs/handoffs/
CONTEXT.md
ReformulationBesoins.md

# Cache YOLO (recréé automatiquement)
*.cache

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store
# Dossier runs/ par defaut d'ultralytics (artefacts YOLO a la racine)
runs/

# Secrets locaux (DATABASE_URL...)
.env

# Uploads runtime de l'app web
Application/backend/uploads/

# Dataset specialiste NumeroBIC (6289 images - hors git)
Application/datasetEnt/

# Modele specialiste BIC tracke
!Application/models/bic/best_*.pt
# Modele BIC navigateur (yolo11n) tracke
!Application/models/bic_browser/best_*.pt

# Dataset caractere (derive + brut tuteur, volumineux - hors git)
Application/dataset/char/
Application/dataset/ocr_container-*/

# Modele caractere tracke
!Application/models/char/best_*.pt

# Rapports d entrainement char (110 Mo, derives - hors git)
Application/reports/char/

# Dataset plaque marocaine (Roboflow brut + split derive, volumineux - hors git)
Application/dataset/plaque_immatriculation_maroc/
Application/dataset/plaque/

# Modele plaque tracke (regenere par trainImmat.bat)
!Application/models/plaque/best_*.pt

# Rapports d entrainement plaque (derives - hors git)
Application/reports/plaque/

# Exports ONNX pour le navigateur (regeneres par export_onnx.py, volumineux)
frontend/models/*.onnx
Application/models/**/*.onnx

# Artefacts de verification front (harness dev + image d'essai du dataset)
frontend/_verify_detect.html
frontend/_verify_video.html
frontend/sample_plaque.jpg
frontend/sample_video.mp4

# Bilans pour le tuteur (hors git)
BILAN_*.md
BILAN_Travail_*.md
*.crdownload
Application/dataset/